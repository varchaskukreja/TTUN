    {
      "path": "sqlglot/expressions/core.py",
      "line": 2882,
      "meaning": "to_identifier exact-string path allocates Identifier; Identifier path calls maybe_copy and can propagate custom state/hooks."
    },
    {
      "path": "sqlglot/expressions/core.py",
